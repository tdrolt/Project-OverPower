  m_Script: {fileID: 11500000, guid: b6ece7837f0e6c14ebcad7cfc05bc72e, type: 3}
  m_Name: Dominion 3v3v3
  m_EditorClassIdentifier: 
  id: 4
  displayName: Dominion 3v3v3
  family: 1
  familyName: Dominion
  sizeName: 3v3v3
  teams: 000000000100000002000000
  seatsPerTeam: 3
  spectatorSeats: 3
  sceneName: Game Scene
  available: 1
  lobbyModeValue: 3
  infoCards:
  - title: Rounds
    text: "Three rounds against the clock. The team with the most points when time runs out wins the round. If the top teams finish close, every team enters overtime: the first to get a 200-point lead on every other team wins the round. If no one manages it, each team within 200 points of the leading team gets a round win. Win two rounds, or lead on round wins after the third, to win the match."
    accent: {r: 0.41960785, g: 0.24705882, b: 0.7490196, a: 1}
  - title: Zones and points
    text: "Every zone your team holds, apart from the centre, earns points every second. Your spawn heals you, but it can't be captured and earns nothing."
    accent: {r: 0.41960785, g: 0.24705882, b: 0.7490196, a: 1}
  - title: The centre
    text: "The centre earns nothing by the second. Instead it pays a big lump of points on a fixed clock to whoever holds it when the clock hits zero."
    accent: {r: 0.41960785, g: 0.24705882, b: 0.7490196, a: 1}
  - title: Bounties
    text: "Hold a zone long enough and it builds a bounty; whoever takes it from you collects the points."
    accent: {r: 0.41960785, g: 0.24705882, b: 0.7490196, a: 1}
  - title: Your build each round
    text: "Every round starts from scratch. In the break before it you pick your gear for free. Round one is the pistol only, round two opens the weapon families and an armor upgrade, and round three opens the weapon upgrades and a second armor upgrade."
    accent: {r: 0.9098039, g: 0.7254902, b: 0.19215687, a: 1}
  - title: Respawns
    text: "You always come back after the same short wait, inside a shield that blocks all damage, stuns and pushes. It breaks when its time runs out, when you hit an enemy or when you leave your spawn, and you can't capture while it's up."
    accent: {r: 0.41960785, g: 0.24705882, b: 0.7490196, a: 1}
  - title: Sudden death
    text: "If the top teams are level on round wins after the third round, or reach two wins together, sudden death starts: no respawns, and a shrinking circle hurts anyone outside it. The last team standing wins."
    accent: {r: 0.41960785, g: 0.24705882, b: 0.7490196, a: 1}
  infoColumns: 4

%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 5b124c880b6f43a4b856fab0c65ce040, type: 3}
  m_Name: HowToPlayPages
  m_EditorClassIdentifier: 
  pages:
  - title: Movement and aiming
    text: 'Move with WASD. Your character aim and shots follow the cursor. The more
      you move the less accurate you will shoot. Some movement abilities can go through
      specific obstacles the arena (example: you can dash/zip across short walls)'
    picture: {fileID: 21300000, guid: c7a379147ed6da147bb7775a3e48f95e, type: 3}
  - title: Shooting and overheat
    text: 'Left click fires your weapon and builds up heat. Fill the bar and you
      overheat preventing you from shooting and using abilities. While you cool down
      a short opening will appear. Press R while its active to massively reduce overheat '
    picture: {fileID: 21300000, guid: a19e311976fa1924e9649c1a33336989, type: 3}
  - title: Ability slots
    text: 'You have 4 abiltiy slots: your weapon on left click, the weapon''s attachment
      on right click, a movement ability on Shift and an ultimate on Space. Everyone
      starts with a pistol and buy the rest in the shop. The ultimate charges as
      you deal damage, take damage and take part in kills, and it can only be used
      when the meter is full. '
    picture: {fileID: 21300000, guid: f0ed4ce77673397479ba202a6ef11802, type: 3}
  - title: Vision
    text: You see in a cone toward your cursor, plus a small circle around you. The
      vision is also shared between team mates. Everything outside your team's sight
      goes dark, and enemies in the dark are hidden. You can still hear their guns
      when they shoot close by.
    picture: {fileID: 21300000, guid: edd03d2852d0839459cdc4ba8e5e86ce, type: 3}
  - title: The shop
    text: 'Press P to open the shop. It has two pages: weapons with the upgrade tree,
      and abilities and armor. Hover your cursor on an item to see what it does.
      You can always sell a weapon/abiltiy but don''t expect a full refund! You can
      upgrade your armor twice; each upgrade either lets it take more damage or makes
      it recharge sooner..'
    picture: {fileID: 21300000, guid: 85a5df7d87709ee45b92df4a3513e085, type: 3}
  - title: Capturing zones
    text: Stand inside a zone's circle to capture it. The more allies in the zone
      the faster it goes. If one or more enemies are in the same zone while you capture
      it becomes contested until only one party remains inside.
    picture: {fileID: 21300000, guid: 437a27b7a1f608a4b8aea9a1af16262f, type: 3}

  m_Script: {fileID: 11500000, guid: b6ece7837f0e6c14ebcad7cfc05bc72e, type: 3}
  m_Name: Conquest 3v3v3
  m_EditorClassIdentifier: 
  id: 1
  displayName: Conquest 3v3v3
  family: 0
  familyName: Conquest
  sizeName: 3v3v3
  teams: 000000000100000002000000
  seatsPerTeam: 3
  spectatorSeats: 3
  sceneName: Game Scene
  available: 1
  lobbyModeValue: 3
  infoCards:
  - title: Goal
    text: Be the last team standing. Take control of the enemy capitals, then finish
      off their players.
    accent: {r: 0.41960785, g: 0.24705882, b: 0.7490196, a: 1}
  - title: Zones
    text: You can only capture a zone next to one your team holds. Tier 3 zones are
      the fastest to capture. The Tier 2 and Tier 1 (capital/base) heal you, but
      Tier 2 heals less.
    accent: {r: 0.41960785, g: 0.24705882, b: 0.7490196, a: 1}
  - title: Gold and upgrades
    text: 'Your first attachment and movement ability are free. Every zone you hold
      except capitals pay your whole team gold while you have control. Spend it in
      the shop inside your own territories when you''re out of combat, or while are
      dead. Holding a zone long enough builds a bounty and the next owner gets a
      bonus when they capture the zone. '
    accent: {r: 0.9098039, g: 0.7254902, b: 0.19215687, a: 1}
  - title: Last stand
    text: Lose your capital and your team stops respawning. Win it back or take an
      enemy capital before the last of you falls.
    accent: {r: 0.41960785, g: 0.24705882, b: 0.7490196, a: 1}
  - title: Map shrink
    text: When the first team is eliminated, its corner of the map closes and the
      remaining teams fight in a smaller arena.
    accent: {r: 0.41960785, g: 0.24705882, b: 0.7490196, a: 1}
  - title: Centre scan
    text: The centre sends out a scan at an interval. If your team holds the centre
      when a scan starts it pings every enemy it passes over.
    accent: {r: 0.41960785, g: 0.24705882, b: 0.7490196, a: 1}
  infoColumns: 0
